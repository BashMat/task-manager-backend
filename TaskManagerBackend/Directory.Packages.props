<Project>
  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
  </PropertyGroup>
  <ItemGroup>
      <!-- Source -->
      <PackageVersion Include="AspNetCore.HealthChecks.UI.Client" Version="8.0.1" />
      <PackageVersion Include="Microsoft.AspNetCore.Authentication.JwtBearer" Version="8.0.14" />
      <PackageVersion Include="Microsoft.EntityFrameworkCore.Design" Version="8.0.17">
          <PrivateAssets>all</PrivateAssets>
          <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      </PackageVersion>
      <PackageVersion Include="NLog.Web.AspNetCore" Version="5.3.8" />
      <PackageVersion Include="prometheus-net.AspNetCore" Version="6.0.0" />
      <PackageVersion Include="prometheus-net.AspNetCore.HealthChecks" Version="6.0.0" />
      <PackageVersion Include="Swashbuckle.AspNetCore" Version="7.3.2" />
      <PackageVersion Include="Swashbuckle.AspNetCore.Filters" Version="7.0.12" />
      <PackageVersion Include="System.Configuration.ConfigurationManager" Version="8.0.1" />
      <PackageVersion Include="Microsoft.Extensions.Configuration.Abstractions" Version="8.0.0" />
      <PackageVersion Include="Microsoft.Extensions.Options" Version="8.0.2" />
      <PackageVersion Include="Microsoft.IdentityModel.Tokens" Version="8.7.0" />
      <PackageVersion Include="System.IdentityModel.Tokens.Jwt" Version="8.7.0" />
      <PackageVersion Include="Microsoft.Data.SqlClient" Version="5.2.2" />
      <PackageVersion Include="Microsoft.EntityFrameworkCore.SqlServer" Version="8.0.17" />
      <PackageVersion Include="Microsoft.Extensions.Logging.Abstractions" Version="8.0.3" />
      
      <!-- Tests -->
      <PackageVersion Include="Bogus" Version="35.5.0" />
      <PackageVersion Include="xunit" Version="2.9.3" />
      <PackageVersion Include="xunit.extensibility.core" Version="2.9.3" />
      <PackageVersion Include="xunit.runner.visualstudio" Version="2.8.2">
          <PrivateAssets>all</PrivateAssets>
          <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      </PackageVersion>
      <PackageVersion Include="coverlet.collector" Version="6.0.0"/>
      <PackageVersion Include="FluentAssertions" Version="7.2.0" />
      <PackageVersion Include="Microsoft.AspNetCore.Mvc.Testing" Version="8.0.15" />
      <PackageVersion Include="Microsoft.NET.Test.Sdk" Version="17.8.0"/>
      <PackageVersion Include="Moq" Version="4.20.70" />
      <PackageVersion Include="System.Net.Http.Json" Version="8.0.1" />
      <PackageVersion Include="Testcontainers.MsSql" Version="4.4.0" />
  </ItemGroup>
</Project>
